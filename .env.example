DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=60
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_TOKENS=512
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ecommerce_documents
KNOWLEDGE_BASE_PATH=data/ecommerce/knowledge
KNOWLEDGE_BASE_CHUNK_SIZE=500
# Required before ordinary or Xianyu RAG can answer. Replace both placeholders
# with existing local model directories; do not leave either value blank.
EMBEDDING_MODEL_PATH=/absolute/path/to/local-embedding-model
RERANKER_MODEL_PATH=/absolute/path/to/local-reranker-model
DENSE_TOP_K=5
BM25_TOP_K=5
RRF_K=60
RERANKER_TOP_K=5
RAG_CONTEXT_MAX_CHUNKS=3
RAG_CONTEXT_SCORE_GAP=0.15
INGESTION_MANIFEST_PATH=.rag_ingestion_manifest.json
ANSWER_RELIABILITY_THRESHOLD=5.3
ANSWER_RELIABILITY_MODEL_ID=Qwen3-Reranker-0.6B
SESSION_DATABASE_PATH=chat_sessions.sqlite3
# Channel delivery/control ledger for Xianyu. This is not the chat-session memory database.
XIANYU_CHANNEL_DATABASE_PATH=logs/xianyu_stage3.sqlite3
SESSION_TTL_SECONDS=3600
SESSION_MAX_COUNT=10000
SESSION_LOCK_TIMEOUT_SECONDS=60
KNOWLEDGE_CORPUS_ID=ecommerce
XIANYU_CORPUS_ID=xianyu
XIANYU_ITEMS_PATH=data/xianyu/items.json
XIANYU_KNOWLEDGE_BASE_PATH=data/xianyu/knowledge
XIANYU_QDRANT_COLLECTION=xianyu_documents
XIANYU_INGESTION_MANIFEST_PATH=.xianyu_ingestion_manifest.json
XIANYU_CHAT_API_BASE_URL=http://127.0.0.1:8000
XIANYU_CHAT_API_TIMEOUT_SECONDS=30
# Create a dedicated Enterprise WeChat group-bot webhook and set it only in .env.
